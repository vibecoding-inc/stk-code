{
  // Cloudflare Workers configuration for the SuperTuxKart WebAssembly web build.
  //
  // This replaces the deprecated Cloudflare Pages deployment. The build output
  // in ./web is served as static assets (with the _headers file applying the
  // COOP/COEP cross-origin-isolation headers), and ./worker/index.mjs handles
  // the single dynamic route (POST /api/token, the Discord OAuth2 exchange).
  //
  // Deploy with `wrangler deploy` (run from this directory). The Discord OAuth
  // secrets are configured out-of-band and must not be committed:
  //   wrangler secret put DISCORD_CLIENT_ID
  //   wrangler secret put DISCORD_CLIENT_SECRET
  "name": "supertuxkart-wasm",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-06-05",

  // Serve on the free https://<name>.<account-subdomain>.workers.dev domain for
  // now (no custom domain / route configured yet).
  "workers_dev": true,

  "assets": {
    "directory": "./web",
    "binding": "ASSETS"
  },

  // Analytics Engine sink for the telemetry pipeline. The browser collector
  // (wasm/web/telemetry.js) batches engine/console/error output to the
  // POST /api/telemetry route (wasm/worker/telemetry.mjs), which writes one
  // data point per log entry to this dataset for queryable ~90-day history.
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY",
      "dataset": "stk_wasm_telemetry"
    }
  ],

  // Workers observability: keep invocation logs and traces persisted so runs
  // can be inspected in the Cloudflare dashboard. Enabling this also persists
  // the compact lines the telemetry handler echoes via console.*, making them
  // tailable with `wrangler tail`.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
