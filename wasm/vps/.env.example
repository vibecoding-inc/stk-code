# Copy this file to `.env` on your VPS and fill in the secret values.

# Cloudflare Tunnel token (from Zero Trust -> Networks -> Tunnels).
# Used by `cloudflared` for both public routes (e.g. stk-gateway) and
# Cloudflare Workers VPC private access to `podium-renderer:3000`.
CLOUDFLARE_TUNNEL_TOKEN=

# Shared bearer token checked by `podium-renderer` in addition to Workers VPC
# network isolation. Generate with: `openssl rand -hex 32`
# Must also be set on the Cloudflare Worker:
#   cd wasm && npx wrangler secret put PODIUM_RENDER_SECRET
PODIUM_RENDER_SECRET=

# Optional: Cloudflare Worker origin + shared bearer token for persisting
# multiplayer match scoreboards (D1) and server-recorded replays (R2).
# Generate GATEWAY_API_SECRET with: `openssl rand -hex 32`
# Must also be set on the Cloudflare Worker:
#   cd wasm && npx wrangler secret put GATEWAY_API_SECRET
MATCH_UPLOAD_URL=https://supertuxkart-wasm.profiluefter.workers.dev
GATEWAY_API_SECRET=
