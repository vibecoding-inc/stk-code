<?xml version="1.0" encoding="UTF-8"?>
<stkgui>
    <div x="5%" y="8%" width="90%" height="84%" layout="vertical-row">
        <header id="title" text_align="center" width="100%" height="12%" align="center"
            I18N="In activity reconnect screen" text="Connection Lost"/>
        <spacer height="4%" width="10"/>
        <box width="85%" proportion="3" align="center" layout="vertical-row">
            <spacer height="6%" width="10"/>
            <label id="reason" width="94%" proportion="2" align="center"
                text_align="center" text_valign="center" word_wrap="true" text=""/>
            <spacer height="4%" width="10"/>
            <label id="status" width="94%" proportion="1" align="center"
                text_align="center" text_valign="center" word_wrap="true" text=""/>
            <spacer height="6%" width="10"/>
        </box>
        <spacer height="6%" width="10"/>
        <div width="75%" height="14%" align="center" layout="horizontal-row">
            <button id="reconnect" proportion="1" height="fit" align="center"
                I18N="In activity reconnect screen" text="Reconnect Now"/>
            <spacer id="btn_spacer" width="5%" height="10"/>
            <button id="reload" proportion="1" height="fit" align="center"
                I18N="In activity reconnect screen" text="Reload Activity"/>
        </div>
        <spacer height="4%" width="10"/>
    </div>
</stkgui>
